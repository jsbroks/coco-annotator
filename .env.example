# Copy to .env (next to docker-compose.yml) and adjust. docker compose reads it.

# Session signing key: set a long random value, e.g.  openssl rand -hex 32
# (if empty, one is generated and stored in the datasets folder as .secret_key)
SECRET_KEY=

# Let anyone with the URL create an account (true | false). With false, only
# the first account can be registered; admins add users in the Admin panel.
#ALLOW_REGISTRATION=false

# Where the images live on this machine (default: ./datasets next to this file).
# Point it at an existing coco-annotator datasets folder to reuse its images.
#DATASETS_DIR=/home/user/coco-annotator/datasets

# Where SAM checkpoints and your YOLO .pt models live (default: ./models)
#MODELS_DIR=./models

# Build the image with PyTorch for SAM and your YOLO models: none | cpu | cuda
#SAM=none
